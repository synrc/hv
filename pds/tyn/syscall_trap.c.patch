 // and restore it to seamlessly return back to BEAM's execution flow.
 __asm__(
 ".global tyn_syscall_entry\n"
 "tyn_syscall_entry:\n"
-"    stp x30, x8, [sp, #-16]!\n"
-"    mov x6, x5\n"
-"    mov x5, x4\n"
-"    mov x4, x3\n"
-"    mov x3, x2\n"
-"    mov x2, x1\n"
-"    mov x1, x0\n"
-"    mov x0, x8\n" // syscall number is in x8 in musl AArch64
+"    // Save all caller-saved registers (except x0 which is return value)\n"
+"    stp x30, x8, [sp, #-16]!\n"
+"    stp x1, x2, [sp, #-16]!\n"
+"    stp x3, x4, [sp, #-16]!\n"
+"    stp x5, x6, [sp, #-16]!\n"
+"    stp x7, x9, [sp, #-16]!\n"
+"    stp x10, x11, [sp, #-16]!\n"
+"    stp x12, x13, [sp, #-16]!\n"
+"    stp x14, x15, [sp, #-16]!\n"
+"    stp x16, x17, [sp, #-16]!\n"
+"    // str x18, [sp, #-16]! -- we can just stp x18, x19 to keep 16-byte align\n"
+"    stp x18, x19, [sp, #-16]!\n"
+"    // Rearrange arguments for C dispatcher\n"
+"    mov x6, x5\n"
+"    mov x5, x4\n"
+"    mov x4, x3\n"
+"    mov x3, x2\n"
+"    mov x2, x1\n"
+"    mov x1, x0\n"
+"    mov x0, x8\n"
 "    bl tyn_syscall_dispatch\n"
-"    ldp x30, x8, [sp], #16\n"
+"    ldp x18, x19, [sp], #16\n"
+"    ldp x16, x17, [sp], #16\n"
+"    ldp x14, x15, [sp], #16\n"
+"    ldp x12, x13, [sp], #16\n"
+"    ldp x10, x11, [sp], #16\n"
+"    ldp x7, x9, [sp], #16\n"
+"    ldp x5, x6, [sp], #16\n"
+"    ldp x3, x4, [sp], #16\n"
+"    ldp x1, x2, [sp], #16\n"
+"    ldp x30, x8, [sp], #16\n"
 "    ret\n"
 );
