+// --- BARE-METAL TERMCAP MOCK ---
+int tgetent(char* bp, char *name) {
+    return 1;
+}
+
+int tgetnum(char* cap) {
+    if (strcmp(cap, "co") == 0) return 80;
+    if (strcmp(cap, "li") == 0) return 24;
+    return -1;
+}
+
+int tgetflag(char* cap) {
+    return 0;
+}
+
+char *tgetstr(char* cap, char** buf) {
+    if (strcmp(cap, "up") == 0) return "\033[A";
+    if (strcmp(cap, "do") == 0) return "\033[B";
+    if (strcmp(cap, "nd") == 0) return "\033[C";
+    if (strcmp(cap, "bc") == 0 || strcmp(cap, "le") == 0) return "\b";
+    if (strcmp(cap, "ce") == 0) return "\033[K";
+    if (strcmp(cap, "cd") == 0) return "\033[J";
+    if (strcmp(cap, "cl") == 0) return "\033[H\033[2J";
+    if (strcmp(cap, "cr") == 0) return "\r";
+    if (strcmp(cap, "nl") == 0) return "\n";
+    if (strcmp(cap, "ho") == 0) return "\033[H";
+    return 0;
+}
+
+int tputs(char* cp, int affcnt, int (*outc)(int c)) {
+    if (!cp) return 0;
+    while (*cp) {
+        outc(*cp++);
+    }
+    return 0;
+}
+// -------------------------------
 #endif /* HAVE_TERMCAP */
