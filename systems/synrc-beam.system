<?xml version="1.0" encoding="UTF-8"?>
<system>
    <!-- Phase 2: Microkit Protection Domains & Console / synrc Isolation -->
    <!-- Memory region for console ring buffer -->
    <memory_region name="console_ring" size="0x4000" page_size="0x1000" />
    <!-- Memory region for audit monitor metrics ring buffer -->
    <memory_region name="monitor_ring" size="0x4000" page_size="0x1000" />
    <!-- Memory region for UART PL011 MMIO registers (0x09000000) -->
    <memory_region name="uart" size="0x1000" phys_addr="0x09000000" page_size="0x1000" />
    <!-- BEAM AArch64 ELF binary (10 MB) loaded by QEMU -device loader at 0x50000000 -->
    <memory_region name="beam_image" size="0xA00000" phys_addr="0x50000000" page_size="0x200000" />
    <!-- OTP rootfs cpio archive (16 MB) loaded by QEMU -device loader at 0x54000000 -->
    <memory_region name="otp_rootfs" size="0x1000000" phys_addr="0x54000000" page_size="0x1000" />
    <!-- BEAM PT_LOAD destination: text 0x400000..0x64fa70, data+BSS 0x65ff78..0x6ae528
         Map 8 MB at 0x400000 with rwx so the ELF loader can write then execute BEAM code -->
    <memory_region name="beam_load_region" size="0x800000" phys_addr="0x58000000" page_size="0x1000" />
    <!-- BEAM Stack (1 MB) -->
    <memory_region name="beam_stack" size="0x100000" page_size="0x1000" />
    <!-- BEAM Heap for SYS_brk (16 MB) -->
    <memory_region name="beam_heap" size="0x1000000" page_size="0x1000" />
    <!-- BEAM Mmap for SYS_mmap (768 MB at 2MB pages) -->
    <memory_region name="beam_mmap" size="0x30000000" page_size="0x200000" />
    <memory_region name="synrc_local_ptr_synrc" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_sched" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_dirty_cpu" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_dirty_io" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_poll" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_rq_super" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_aux" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker6" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker7" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker8" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker9" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker10" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker11" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker12" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker13" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker14" size="0x1000" page_size="0x1000" />
    <memory_region name="synrc_local_ptr_beam_worker15" size="0x1000" page_size="0x1000" />

    <!-- Protection Domain 1: Console (Exclusive UART Owner) -->
    
    <memory_region name="sys_state" size="0x40000" page_size="0x1000" />
    <memory_region name="thread_mailbox" size="0x1000" page_size="0x1000" />
    <protection_domain name="console" priority="254">
        <program_image path="console.elf" />
        <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
        <map mr="uart" vaddr="0x09000000" perms="rw" cached="false" />
        <irq irq="33" id="2" />
    </protection_domain>
    <!-- Protection Domain 2: Audit Monitor (Metrics & NIST AU Audit Logger) -->
    <protection_domain name="audit_monitor" priority="200">
        <program_image path="monitor.elf" />
        <map mr="monitor_ring" vaddr="0x10000000" perms="rw" cached="true" />
    </protection_domain>
    <!-- Protection Domain 3: synrc (musl Syscall Trap Surface & BEAM Host) -->
    <protection_domain name="synrc" priority="220">
        <program_image path="synrc.elf" />
        <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
        <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
        <map mr="synrc_local_ptr_synrc" vaddr="0x08000000" perms="rw" cached="true" />
        <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
        <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
        <!-- BEAM ELF binary mapped at 0x50000000 (read + execute) -->
        <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
        <!-- OTP rootfs cpio mapped at 0x54000000 (read-only) -->
        <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
        <!-- BEAM PT_LOAD destination at 0x400000: rwx so loader writes then BEAM executes -->
        <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
        <!-- Runtime memory for BEAM process -->
        <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
        <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
        <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />

        <protection_domain name="beam_sched" id="1" priority="220">
            <program_image path="beam_sched.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_sched" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>

        <protection_domain name="beam_dirty_cpu" id="2" priority="220">
            <program_image path="beam_dirty_cpu.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_dirty_cpu" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>

        <protection_domain name="beam_dirty_io" id="3" priority="220">
            <program_image path="beam_dirty_io.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_dirty_io" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>

        <protection_domain name="beam_poll" id="4" priority="220">
            <program_image path="beam_poll.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_poll" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>

        <protection_domain name="beam_rq_super" id="5" priority="220">
            <program_image path="beam_rq_super.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_rq_super" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>

        <protection_domain name="beam_aux" id="6" priority="220">
            <program_image path="beam_aux.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_aux" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>

        <protection_domain name="beam_worker6" id="7" priority="220">
            <program_image path="beam_worker6.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_worker6" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>

        <protection_domain name="beam_worker7" id="8" priority="220">
            <program_image path="beam_worker7.elf" />
            <map mr="console_ring" vaddr="0x10000000" perms="rw" cached="true" />
            <map mr="monitor_ring" vaddr="0x20000000" perms="rw" cached="true" />
            <map mr="synrc_local_ptr_beam_worker7" vaddr="0x08000000" perms="rw" cached="true" />
            <map mr="thread_mailbox" vaddr="0x21000000" perms="rw" cached="true" />
            <map mr="sys_state" vaddr="0x22000000" perms="rw" cached="true" />
            <map mr="beam_image" vaddr="0x50000000" perms="rx" cached="true" />
            <map mr="otp_rootfs" vaddr="0x54000000" perms="r" cached="true" />
            <map mr="beam_load_region" vaddr="0x00400000" perms="rwx" cached="true" />
            <map mr="beam_stack" vaddr="0x65000000" perms="rw" cached="true" />
            <map mr="beam_heap" vaddr="0x30000000" perms="rw" cached="true" />
            <map mr="beam_mmap" vaddr="0x80000000" perms="rwx" cached="true" />
        </protection_domain>
    </protection_domain>

    <!-- Channel 1: synrc <-> Console -->
    <channel>
        <end pd="synrc" id="1" />
        <end pd="console" id="1" />
    </channel>
    <!-- Channel 2: synrc <-> Audit Monitor -->
    <channel>
        <end pd="synrc" id="2" />
        <end pd="audit_monitor" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="3" />
        <end pd="beam_sched" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="4" />
        <end pd="beam_dirty_cpu" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="5" />
        <end pd="beam_dirty_io" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="6" />
        <end pd="beam_poll" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="7" />
        <end pd="beam_rq_super" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="8" />
        <end pd="beam_aux" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="9" />
        <end pd="beam_worker6" id="1" />
    </channel>
    <channel>
        <end pd="synrc" id="10" />
        <end pd="beam_worker7" id="1" />
    </channel>
</system>
